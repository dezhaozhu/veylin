# Veylin local dev config (points the agent at Compass's on-prem LLM gateway)
VEYLIN_DATA_DIR=./data

# Single-user desktop mode — skip auth (server only on localhost). Fine for local dev.
VEYLIN_DESKTOP_AUTH=1

# ---- Models: Compass's on-prem OpenAI-compatible gateway (kimi) ----
VEYLIN_API_KEY=sk-DS4ACAMRhGC10HUxtGLpbg
VEYLIN_BASE_URL=https://llm.youdamaster.cc/v1
VEYLIN_MODEL=kimi-k2.7-code

# Embeddings run locally (offline)
EMBEDDING_PROVIDER=local

PORT=8787
LANGFUSE_ENABLED=false
